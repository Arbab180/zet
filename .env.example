# Copy to .env.local and fill in. .env.local is gitignored — keep it that way.
#
# Generate ADMIN_PASSWORD_HASH and SESSION_SECRET with:
#     npm run hash-password

# ── The admin account (src/server/auth.ts) ───────────────────────────────
# The admin sees every restaurant and creates the restaurant logins on the
# /accounts page. Restaurant logins live in the database (migration 0008),
# never here.

ADMIN_USERNAME=admin

# scrypt\$... — from `npm run hash-password`. Never the password itself.
# Keep every `$` written as `\$`, exactly as the script prints it: Next.js
# expands `$NAME` here even inside quotes, and a bare hash loads as `scrypt`.
ADMIN_PASSWORD_HASH=

# The app_user.id this session acts as. It must exist in app_user and have
# restaurant_user rows, or every save is correctly refused as not_authorised.
ADMIN_USER_ID=

# HMAC key for the session cookie. Long and random; changing it signs
# everyone out. Never share it between environments.
SESSION_SECRET=

# ── Database ─────────────────────────────────────────────────────────────
# Must NOT be the role that owns the tables, and must not have BYPASSRLS or
# be a superuser: owners and superusers bypass row-level security, which
# would silently switch off per-restaurant authorisation. src/lib/db.ts
# refuses to serve a single query if it detects any of those.
DATABASE_URL=postgres://zet_app:password@localhost:5432/zet

# ── Receipt photos: Cloudflare R2 ────────────────────────────────────────
# Leave these unset and the photo button says photos are not set up. It
# never pretends to have saved one.
#
# In the Cloudflare dashboard: R2 → create a bucket (private, NOT public) →
# Manage API tokens → create a token with Object Read & Write, scoped to
# that bucket only.
#
# The bucket must stay private. These are business records showing
# suppliers and amounts; the app issues short-lived signed URLs for every
# upload and every read, so nothing is ever reachable by guessing a URL.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=zet-receipts

# ── Reading amounts off receipts ─────────────────────────────────────────
# From console.anthropic.com. Server-side only — it is never sent to the
# browser. Leave unset and the photo still uploads; only the automatic
# amount is unavailable.
#
# This is the one genuinely per-use cost in the project. Set a spend limit
# on the key while you find out what it actually costs.
#
# Since the scan also lists a receipt's items (October 2026), a scan's cost
# grows with the length of the receipt: a long supermarket receipt is
# several times a short one. Still cents, but it is no longer a flat
# figure per photo — check the usage page after the first week of real use.

ANTHROPIC_API_KEY=
# Optional; defaults to claude-sonnet-4-5.
ANTHROPIC_SCAN_MODEL=
