{
  "name": "zet",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "hash-password": "node --experimental-strip-types scripts/hash-password.ts",
    "db:setup": "./scripts/db-setup.sh",
    "db:reset": "./scripts/db-setup.sh --reset",
    "db:demo": "psql ${ZET_DB_NAME:-zet} -v ON_ERROR_STOP=1 -f db/demo.sql",
    "db:demo:clear": "psql ${ZET_DB_NAME:-zet} -v ON_ERROR_STOP=1 -f db/demo-clear.sql",
    "r2:check": "node --env-file=.env.local --experimental-strip-types scripts/r2-check.ts",
    "scan:check": "node --env-file=.env.local --experimental-strip-types scripts/scan-check.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "next": "^16.3.6",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": "22.x"
  }
}
